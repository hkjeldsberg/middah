# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key

# yt-dlp, for importing recipes from Instagram reels and posts (/recipes/import).
# Optional: falls back to .venv/bin/yt-dlp, then yt-dlp on PATH.
# YTDLP_PATH=/full/path/to/yt-dlp
# Instagram often requires a logged-in session. Set one of these if you get
# a login error — a browser name, or a cookies.txt file.
# YTDLP_COOKIES_FROM_BROWSER=chrome
# YTDLP_COOKIES_FILE=/full/path/to/cookies.txt
